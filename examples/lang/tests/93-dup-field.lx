// `p.f += e` must evaluate its receiver exactly ONCE. The receiver here is a
// call with a side effect, `pick(s)`, and `calls` counts it: the answer is 1.
//
// Before this the answer was 2, and silently so, because the stored value was
// right: `lg_field_use` built the address `left + off` for the store and a
// SECOND `left + off` for the load, so the receiver EXPRESSION was reachable
// from two nodes and the walker lowered it twice. The same blind spot as
// 92-dup-eval.lx -- every other test compounds into a field of a plain name,
// where a second evaluation cannot be seen.
// expect-exit: 0
// expect-stdout: 6
// expect-stdout: 1
#include "../lib/prelude.lx"

i64 calls = 0;

class Shape {
    i64 k;
}

fn pick(Shape s) -> Shape {
    calls = calls + 1;
    return s;
}

fn main() -> i64 {
    {
        Shape s = new Shape();
        s.k = 5;
        pick(s).k += 1;
        print(s.k);
        print(calls);
    }
    return 0;
}
