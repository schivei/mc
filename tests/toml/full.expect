str  project.name = "api"
str  project.entry = "main.mc"
str  project.out = "build/api"
str  project.kind = "exe"
str  target.os = "macos"
str  target.arch = "aarch64"
str  compiler.core = "../../src/core.mc"
str  compiler.modules[0] = "mc-api.mc"
str  compiler.out = "build/mc-api"
str  linker.cmd = "ld"
str  linker.args[0] = "-o"
str  linker.args[1] = "{out}"
str  linker.args[2] = "{obj}"
str  linker.args[3] = "-lSystem"
str  linker.args[4] = "-syslibroot"
str  linker.args[5] = "{sdk}"
str  linker.args[6] = "-arch"
str  linker.args[7] = "arm64"
str  linker.args[8] = "{libs}"
str  libs.sqlite3 = "/usr/lib/libsqlite3.dylib"
str  externs.sqlite3_* = "sqlite3"
str  include.paths[0] = "lib"
